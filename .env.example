# ==============================================================================
# NOIR & STEEL · ATELIER ENVIRONMENT CONFIGURATION
# ==============================================================================
# The website functions out of the box in high-fidelity Demonstration Mode
# without requiring any API keys. To activate optional live integrations,
# configure the environment variables below:

# 1. OPTIONAL: Google Gemini API Key for dynamic Generative AI Concierge
# When omitted, the system seamlessly uses the built-in deterministic expert concierge engine.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OPTIONAL: Supabase / PostgreSQL for persistent cloud appointment storage
# When omitted, an in-memory simulated database with conflict detection is used.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. OPTIONAL: n8n Webhook for Telegram / Email booking notifications
# N8N_BOOKING_WEBHOOK_URL=https://your-n8n-instance.com/webhook/noir-booking

# 4. Canonical Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
